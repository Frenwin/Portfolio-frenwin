	column MonthKey
		dataType: int64
		isHidden
		lineageTag: 6acfbab5-3777-52ba-bb53-00a9bd13c16f
		summarizeBy: none
		sourceColumn: MonthKey

	column 'Month Start'
		dataType: dateTime
		formatString: mmm yyyy
		lineageTag: e5d248b1-0d9c-5b9c-ad1d-4fc2894ee827
		summarizeBy: none
		sourceColumn: Month Start

	partition Date = m
		mode: import
		source =
				let
				    Source = Excel.Workbook(File.Contents(SourceFile), null, true),
				    Data = Source{[Item="Date",Kind="Table"]}[Data],
				    Typed = Table.TransformColumnTypes(Data, {{"DateKey", Int64.Type}, {"Date", type date}, {"Fiscal Year", type text}, {"Fiscal Quarter", type text}, {"Month", type text}, {"Full Date", type text}, {"MonthKey", Int64.Type}}),
				    Trimmed = Table.SelectRows(Typed, each [Date] <= #date(2020, 6, 30)),
				    WithMonthStart = Table.AddColumn(Trimmed, "Month Start", each Date.StartOfMonth([Date]), type date)
				in
				    WithMonthStart
