model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["SourceFile", "Sales", "Date", "Product", "Customer", "Reseller", "SalesTerritory", "SalesOrder"]

annotation __PBI_TimeIntelligenceEnabled = 0

ref table Sales
ref table Date
ref table Product
ref table Customer
ref table Reseller
ref table SalesTerritory
ref table SalesOrder
